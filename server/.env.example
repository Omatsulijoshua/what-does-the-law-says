# What Does Nigerian Law Say? Backend Configuration

# Get your Gemini API Key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override Gemini models without changing code.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# Server Port
PORT=5000

# Configure these on the server to enable admin access.
ADMIN_EMAIL=
ADMIN_PASSWORD=

NODE_ENV=production
FRONTEND_ORIGINS=https://what-does-nigeria-law-says.thispage.xyz,https://what-does-nigerian-law-say.vercel.app
# Optional: set DATA_DIR to a persistent disk mount for analytics and articles.
# DATA_DIR=/var/data
